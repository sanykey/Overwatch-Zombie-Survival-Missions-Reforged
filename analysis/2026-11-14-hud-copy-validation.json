  "descriptions": [
    {
      "kind": "menu",
      "key": "enhancementId",
      "id": 1,
      "text": "Critical hits deal +60% dmg; +20% against bosses.",
      "length": 49
    },
    {
      "kind": "menu",
      "key": "enhancementId",
      "id": 2,
      "text": "Gain infection faster and convert it into an explosion dealing 100 dmg per infection level.",
      "length": 91
    },
    {
      "kind": "menu",
      "key": "enhancementId",
      "id": 3,
      "text": "Damaging zombies within 15m sets them on fire for 3s.",
      "length": 53
    },
    {
      "kind": "menu",
      "key": "enhancementId",
      "id": 4,
      "text": "+30% healing, increased to +62.5% on infected allies. Healing reduces infection in you and infected allies.",
      "length": 107
    },
    {
      "kind": "menu",
      "key": "enhancementId",
      "id": 5,
      "text": "Final blows store ability resets, up to 2. Your next ability use consumes a reset.",
      "length": 82
    },
    {
      "kind": "menu",
      "key": "enhancementId",
      "id": 6,
      "text": "Place a battery that grants 15% ultimate charge on contact. Recharges in 10s; placement cd: 20s.",
      "length": 96
    },
    {
      "kind": "menu",
      "key": "enhancementId",
      "id": 7,
      "text": "Ride a nearby teammate and share your combined health while attached.",
      "length": 69
    },
    {
      "kind": "menu",
      "key": "enhancementId",
      "id": 8,
      "text": "An autonomous drone burns and knocks down nearby zombies, or freezes distant targets and nearby zombies.",
      "length": 104
    },
    {
      "kind": "menu",
      "key": "enhancementId",
      "id": 9,
      "text": "+15% healing. Bank healing/3 (packs included) +10 per assist. Spend up to 100 energy for bonus dmg per hit.",
      "length": 107
    },
    {
      "kind": "menu",
      "key": "enhancementId",
      "id": 10,
      "text": "Each elimination: +0.5% max HP (up to 2x), +0.75% size (up to 2.5x). Lose half your stacks on death.",
      "length": 100
    },
    {
      "kind": "menu",
      "key": "enhancementId",
      "id": 11,
      "text": "Grab zombies within 5m, including bosses, while disabled (root alone excluded) or below 20% HP. Take 50% less dmg while carrying.",
      "length": 129
    },
    {
      "kind": "menu",
      "key": "enhancementId",
      "id": 12,
      "text": "Hits chain to 2 zombies within 10m for 25% dmg (max 15). At 350 energy, arm a 60-dmg blast that stuns zombies within 10m for 2s.",
      "length": 128
    },
    {
      "kind": "menu",
      "key": "enhancementId",
      "id": 13,
      "text": "Scrap: +10 per zombie death within 15m, +15 per assist, +1/s. Craft armor for yourself or allies (up to 100 each) and freezing turrets.",
      "length": 135
    },
    {
      "kind": "menu",
      "key": "augmentId",
      "id": 1,
      "text": "+75 armor, 50% knockback resistance. 50% resistance to ranged and ability dmg.",
      "length": 78
    },
    {
      "kind": "menu",
      "key": "augmentId",
      "id": 2,
      "text": "Dash in your movement direction with 1.70s invulnerability. Stores 2 charges; restores one every 14s.",
      "length": 101
    },
    {
      "kind": "menu",
      "key": "augmentId",
      "id": 3,
      "text": "Launch upward and gain +20% dmg until landing. Activate with Jump in midair or a double-tap. cd: 16s.",
      "length": 101
    },
    {
      "kind": "menu",
      "key": "augmentId",
      "id": 4,
      "text": "Triple melee reach; weapon hits at extended range deal 75% dmg. Push visible zombies ahead within 10m. Push cd: 9s.",
      "length": 115
    },
    {
      "kind": "menu",
      "key": "augmentId",
      "id": 5,
      "text": "Double magazine capacity. Fully reloading restores the extra ammo.",
      "length": 66
    },
    {
      "kind": "menu",
      "key": "augmentId",
      "id": 6,
      "text": "Grapple to allies or zombies 7–40m away. 35 dmg; stun grounded zombies or knock airborne ones down for 3s. cd: 16s.",
      "length": 115
    },
    {
      "kind": "menu",
      "key": "augmentId",
      "id": 7,
      "text": "Deploy a wall that blocks zombies. Hold Crouch + Interact to aim; release Interact to place. cd: 25s.",
      "length": 101
    },
    {
      "kind": "menu",
      "key": "augmentId",
      "id": 8,
      "text": "Packs: 2x healing, -1 infection, +7% ult. Ult grants a teleport to your last used pack.",
      "length": 87
    },
    {
      "kind": "menu",
      "key": "augmentId",
      "id": 9,
      "text": "Carry 2 extra powerups. Eliminations: 7% chance to gain a powerup. Loot fills your active slot, then backpack.",
      "length": 110
    },
    {
      "kind": "menu",
      "key": "augmentId",
      "id": 10,
      "text": "Heal for 15% of dmg dealt. Gain 50 recoverable health.",
      "length": 54
    },
