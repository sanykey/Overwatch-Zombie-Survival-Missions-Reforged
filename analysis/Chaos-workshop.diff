+rule("ZOMBIE HYRBID")
+{
+	event
+	{
+		Ongoing - Each Player;
+		Team 1;
+		All;
+	}
+
+	conditions
+	{
+		Event Player.enhancementValues[0] == 2;
+		Is Button Held(Event Player, Button(Melee)) == True;
+		Is Alive(Event Player) == True;
+		Event Player.enhancementValues[4] <= 0;
+		Event Player.infectionLvl >= 1;
+	}
+
+	actions
+	{
+		Call Subroutine(explosionSequence);
+		Stop Damage Over Time(Event Player.infectionDamage);
+		Event Player.infectionLvl = 0;
+		Event Player.enhancementValues[4] = 20;
+		While(Event Player.enhancementValues[4] > 0);
+			Wait(1, Ignore Condition);
+			Event Player.enhancementValues[4] += -1;
+		End;
+	}
+}
