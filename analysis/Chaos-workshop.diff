+			Event Player.enhancementValues[4]);
+		Set Player Health(Event Player.enhancementValues[4], Health(Event Player.enhancementValues[4])
+			+ Event Player.enhancementValues[3]);
+		Set Player Health(Event Player.enhancementValues[5], Health(Event Player.enhancementValues[5])
+			- Event Player.enhancementValues[3]);
+		Wait(0.016, Ignore Condition);
